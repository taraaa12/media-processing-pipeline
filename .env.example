# PostgreSQL
POSTGRES_USER=media_user
POSTGRES_PASSWORD=media_password
POSTGRES_DB=media_processing
DATABASE_URL=postgresql+asyncpg://media_user:media_password@postgres:5432/media_processing
DATABASE_URL_SYNC=postgresql://media_user:media_password@postgres:5432/media_processing

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Backend
SECRET_KEY=change-me-in-production
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://frontend:80
LOG_LEVEL=INFO

# Frontend (build-time)
# Leave empty for Docker/nginx same-origin /api proxy (recommended for docker compose up).
# Set to http://localhost:8000 only for direct backend access without proxy.
VITE_API_BASE_URL=
